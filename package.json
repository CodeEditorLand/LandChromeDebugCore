{
	"name": "@codeeditorland/chrome-debug-core",
	"displayName": "vscode-chrome-debug-core",
	"version": "0.0.1",
	"private": false,
	"description": "A library for building VS Code debug adapters for targets that support the Chrome Remote Debug Protocol",
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/LandChromeDebugCore#readme",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/LandChromeDebugCore/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/LandChromeDebugCore.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "HTTPS://Editor.Land"
	},
	"type": "module",
	"main": "./out/src/index",
	"typings": "./lib/src/index.d.ts",
	"scripts": {
		"build": "gulp build",
		"major": "npm version major -m '%s'",
		"minor": "npm version minor -m '%s'",
		"patch": "npm version patch -m '%s'",
		"prepare": "gulp build",
		"prepublishOnly": "Build 'Source/**/*.ts'",
		"testCoverage": "nyc mocha --require source-map-support/register  --exit --recursive -u tdd ./out/test/**/*.test.js"
	},
	"nyc": {
		"all": true,
		"exclude": [
			"**/*.d.ts",
			"**/coverage/**/*.*",
			"**/testData/**/*.*"
		],
		"extension": [
			".ts"
		],
		"reporter": "html"
	},
	"dependencies": {
		"@types/source-map": "0.5.7",
		"color": "5.0.0",
		"devtools-protocol": "0.0.1449749",
		"glob": "11.0.1",
		"noice-json-rpc": "1.2.0",
		"source-map": "0.7.4",
		"ws": "8.18.1"
	},
	"devDependencies": {
		"@playform/build": "0.2.3",
		"@types/color": "4.2.0",
		"@types/glob": "8.1.0",
		"@types/minimatch": "5.1.2",
		"@types/mockery": "1.4.33",
		"@types/node": "22.14.1",
		"@types/ws": "8.18.1",
		"del": "8.0.0",
		"event-stream": "4.0.1",
		"merge2": "1.4.1",
		"minimist": "1.2.8",
		"mockery": "2.1.0",
		"nyc": "17.1.0",
		"source-map-support": "0.5.21",
		"typemoq": "2.1.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
